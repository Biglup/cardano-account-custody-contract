{
  "name": "cardano-account-custody-offchain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Off-chain library for the Cardano account custody contract: datum and redeemer encoders, account address derivation and transaction builders built on cometa.js.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "budgets": "tsx scripts/budget-gate.ts",
    "links": "tsx scripts/docs-links.ts",
    "e2e": "tsx scripts/preprod-e2e.ts",
    "setup": "SETUP_ONLY=1 tsx scripts/preprod-e2e.ts",
    "devnet:parameters": "tsx scripts/devnet-parameters.ts",
    "devnet:start": "devnet/start.sh",
    "devnet:stop": "devnet/stop.sh",
    "devnet:reset": "devnet/reset.sh",
    "devnet:e2e": "CARDANO_NETWORK=devnet tsx scripts/preprod-e2e.ts",
    "devnet:bootstrap": "CARDANO_NETWORK=devnet tsx scripts/devnet-bootstrap.ts"
  },
  "dependencies": {
    "@biglup/cometa": "^1.2.0",
    "@harmoniclabs/plutus-data": "^2.0.1",
    "@harmoniclabs/uplc": "^2.0.7",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.26.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.0"
  }
}

    "cardano_account_custody_contract/types/AccountRedeemer": {
      "title": "AccountRedeemer",
      "description": "The redeemer for the account validator's spend handler.\n\n `Device` is the owner path: any device key may rewrite the state freely,\n as long as the result stays well formed. `SpendWithGrant` is the agent\n path: the named grant's remaining caps bound what the transaction may\n take. `Fund` is for a plain deposit UTxO at the account address, which\n only requires that the account's own state NFT is spent alongside it.",
      "anyOf": [
        {
          "title": "Device",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "SpendWithGrant",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "slot",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "signature",
              "description": "The 64 byte r||s secp256k1 ECDSA signature over the transaction,\n required when the grant's grantee is `Secp256k1`. `None` when the\n grantee is `Ed25519`, which authorises through `extra_signatories`\n instead.",
              "$ref": "#/definitions/Option<ByteArray>"
            }
          ]
        },
        {
          "title": "Fund",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        }
      ]
    },
    "cardano_account_custody_contract/types/MintRedeemer": {
      "title": "MintRedeemer",
      "description": "The redeemer for the account validator's mint handler, which creates\n the account's state NFT. The NFT is never burned, so creation is the\n handler's only purpose and `CreateAccount` its only value.",
      "anyOf": [
        {
          "title": "CreateAccount",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        }
      ]
    },
    "cardano_account_custody_contract/types/StakeRedeemer": {
      "title": "StakeRedeemer",
      "description": "The redeemer for the account stake validator's withdraw and publish\n handlers. Both handlers learn what they are authorising from the script\n context itself, the credential a withdrawal draws from or the\n certificate being published, so the redeemer carries no choice and\n `Operate` is its only value.",
      "anyOf": [
        {
          "title": "Operate",
